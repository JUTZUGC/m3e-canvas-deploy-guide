    "deploy": {
      "type": "script",
      "requires": [
        "node"
      ],
      "steps": [
        "git clone https://github.com/lnkiai/m3e-canvas.git",
        "cd m3e-canvas && npm install",
        "npm run dev",
        "echo \"打开 http://localhost:3000\""
      ],
      "stepsPs": [
        "git clone https://github.com/lnkiai/m3e-canvas.git",
        "Set-Location m3e-canvas; npm install",
        "npm run dev",
        "Write-Host \"打开 http://localhost:3000\""
      ],
      "source": "https://github.com/lnkiai/m3e-canvas#run-it-locally"
    },
    "pitfalls": [
      "3000 被占用：换端口启动",
      "页面空白：确认 `npm install` 完成",
      "提示词不完整：补齐屏幕说明与行为备注",
      "换设备丢设计：先导出或复制分享链接",
      "AI 助手报错：检查 Key 与额度",
      "子路径部署 404：设置 `NEXT_PUBLIC_BASE_PATH`"
